;; nbb reads this file. It does NOT read deps.edn, and the
;; .cljs here are run as bare `nbb <file>`, so a coordinate declared only
;; there is invisible to them.
;;
;; :paths and every sha below are COPIED from deps.edn, not chosen here.
{:paths ["src" "."]
 :deps {
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.coll"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.test"}
        ;; Declared HERE and not only in deps.edn: nbb reads nbb.edn and does NOT
        ;; read deps.edn or bb.edn, and the .cljs in this repo are run as
        ;; bare `nbb <file>`. A coordinate they cannot see is not a
        ;; declaration. sha and :paths are COPIED from deps.edn.
        ;; content-address is NOT declared here, though otent.lake needs it.
        ;; A new git coordinate makes nbb resolve deps on a cold cache, and nbb
        ;; does that by shelling out to `bb` -- absent under launchd. Declared
        ;; here on 2026-09-23, it stopped every scheduled cycle at startup
        ;; (`/bin/sh: bb: command not found`). Every entry point that loads
        ;; otent.lake puts ../../kotoba-lang/content-address/src on its
        ;; classpath instead: bin/scheduled.cljk's child, the weather plist,
        ;; package.json's test. deps.edn keeps the coordinate for tools.deps.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.text"}}}
