(ns otent.r2
  "Writing objects to the R2 bucket, over the Cloudflare REST object API.

  The REST API rather than the S3 one because it takes the same Bearer
  token everything else here uses: no second credential to store, and no
  signing to get wrong.

  This lived inside `bin/basemap.cljk` until the ingest tick needed it too.
  Two copies of a credentialed PUT is how one of them quietly grows a
  different retry rule."
  (:require ["crypto" :as crypto]
            ["zlib" :as zlib]
            [kotoba.lang.text :as str]
            [otent.deadline :as dl]))

(def account "4da88288dc30d9ee257f319d3c33ecf0")
(def bucket "cloud-itonami-datalake")

(defn token
  "The catalog/R2 bearer token, or nil.

  Returns nil rather than exiting: a caller that can still do useful work
  without writing should be allowed to say so. Callers that cannot must
  exit 2 themselves -- `could not write` is not `wrote nothing`."
  []
  (some-> (aget js/process.env "CF_CATALOG_TOKEN") str/trim not-empty))

(defn sha256 [buf]
  (-> (crypto/createHash "sha256") (.update buf) (.digest "hex")))

(defn gzip [^js buf]
  (.gzipSync zlib buf))

(declare put-to!)

(defn put!
  "PUT one object into the datalake bucket. Resolves `{:ok? true :key ...}`
  or a refusal that names the status -- never a silent failure."
  [key body content-type]
  (put-to! bucket key body content-type))

(defn put-to!
  "`put!` into a named bucket. The yataverse.com lake is a different bucket
  in the same account (`otent.lake`); one PUT, so the two cannot grow
  different retry rules."
  [bkt key body content-type]
  (if-let [t (token)]
    (-> (js/fetch (str "https://api.cloudflare.com/client/v4/accounts/" account
                       "/r2/buckets/" bkt "/objects/" key)
                  #js {:method "PUT"
                       :signal (dl/signal dl/upload-ms)
                       :headers #js {"Authorization" (str "Bearer " t)
                                     "Content-Type" content-type}
                       :body body})
        (.then (fn [r]
                 (if (.-ok r)
                   {:ok? true :key key}
                   (.then (.text r)
                          (fn [txt] {:ok? false :error :r2/put-failed
                                     :detail (str (.-status r) " " (subs txt 0 (min 200 (count txt))))})))))
        (.catch (fn [e] {:ok? false :error :r2/unreachable :detail (str (.-message e))})))
    (js/Promise.resolve
     {:ok? false :error :r2/no-credential
      :detail "$CF_CATALOG_TOKEN is not set: nothing was written, which is not the same as writing nothing"})))

(declare head-in)

(defn head
  "Does this key already exist? `{:ok? true :present? bool}` or a refusal.

  A one-byte ranged GET, not HEAD: measured 2026-08-26, the Cloudflare REST
  object API answers HEAD with a non-2xx even for objects that are present,
  so a HEAD probe reports an empty bucket."
  [key]
  (head-in bucket key))

(defn head-in
  "`head` in a named bucket."
  [bkt key]
  (if-let [t (token)]
    (-> (js/fetch (str "https://api.cloudflare.com/client/v4/accounts/" account
                       "/r2/buckets/" bkt "/objects/" key)
                  #js {:method "GET"
                       :signal (dl/signal)
                       :headers #js {"Authorization" (str "Bearer " t)
                                     "Range" "bytes=0-0"}})
        (.then (fn [r] {:ok? true :present? (or (.-ok r) (= 206 (.-status r)))}))
        (.catch (fn [e] {:ok? false :error :r2/unreachable :detail (str (.-message e))})))
    (js/Promise.resolve {:ok? false :error :r2/no-credential})))

(defn get-text
  "GET one object as text. `{:ok? true :text s}`, `{:ok? true :text nil}`
  when the key is absent (a first run has no previous manifest, and that
  is not a failure), or a refusal."
  [key]
  (if-let [t (token)]
    (-> (js/fetch (str "https://api.cloudflare.com/client/v4/accounts/" account
                       "/r2/buckets/" bucket "/objects/" key)
                  #js {:method "GET"
                       :signal (dl/signal)
                       :headers #js {"Authorization" (str "Bearer " t)}})
        (.then (fn [r]
                 (cond
                   (.-ok r) (.then (.text r) (fn [s] {:ok? true :text s}))
                   (= 404 (.-status r)) {:ok? true :text nil}
                   :else {:ok? false :error :r2/get-failed :detail (str (.-status r))})))
        (.catch (fn [e] {:ok? false :error :r2/unreachable :detail (str (.-message e))})))
    (js/Promise.resolve {:ok? false :error :r2/no-credential})))

(defn delete!
  "DELETE one object. A 404 counts as done: the object not being there is
  what was asked for."
  [key]
  (if-let [t (token)]
    (-> (js/fetch (str "https://api.cloudflare.com/client/v4/accounts/" account
                       "/r2/buckets/" bucket "/objects/" key)
                  #js {:method "DELETE"
                       :signal (dl/signal)
                       :headers #js {"Authorization" (str "Bearer " t)}})
        (.then (fn [r] (if (or (.-ok r) (= 404 (.-status r)))
                         {:ok? true :key key}
                         {:ok? false :error :r2/delete-failed :key key
                          :detail (str (.-status r))})))
        (.catch (fn [e] {:ok? false :error :r2/unreachable :detail (str (.-message e))})))
    (js/Promise.resolve {:ok? false :error :r2/no-credential})))

(defn get-bytes
  "GET one object as a Buffer. `{:ok? true :bytes buf}`, `{:ok? true :bytes nil}`
  when absent, or a refusal."
  [key]
  (if-let [t (token)]
    (-> (js/fetch (str "https://api.cloudflare.com/client/v4/accounts/" account
                       "/r2/buckets/" bucket "/objects/" key)
                  #js {:method "GET"
                       :signal (dl/signal dl/upload-ms)
                       :headers #js {"Authorization" (str "Bearer " t)}})
        (.then (fn [r]
                 (cond
                   (.-ok r) (.then (.arrayBuffer r) (fn [b] {:ok? true :bytes (js/Buffer.from b)}))
                   (= 404 (.-status r)) {:ok? true :bytes nil}
                   :else {:ok? false :error :r2/get-failed :detail (str (.-status r))})))
        (.catch (fn [e] {:ok? false :error :r2/unreachable :detail (str (.-message e))})))
    (js/Promise.resolve {:ok? false :error :r2/no-credential})))

(defn list-keys
  "Every key under `prefix`, following the cursor. Resolves `{:ok? true
  :keys [...]}` or a refusal -- a listing that stopped early is not a
  shorter listing."
  [prefix]
  (if-let [t (token)]
    (letfn [(page [cursor acc]
              (-> (js/fetch (str "https://api.cloudflare.com/client/v4/accounts/" account
                                 "/r2/buckets/" bucket "/objects?per_page=1000&prefix="
                                 (js/encodeURIComponent prefix)
                                 (when cursor (str "&cursor=" (js/encodeURIComponent cursor))))
                            #js {:signal (dl/signal)
                                 :headers #js {"Authorization" (str "Bearer " t)}})
                  (.then (fn [r] (if (.-ok r) (.json r)
                                     (throw (js/Error. (str "list HTTP " (.-status r)))))))
                  (.then (fn [j]
                           (let [acc (into acc (map #(aget % "key")) (array-seq (aget j "result")))
                                 info (aget j "result_info")]
                             (if (and info (aget info "is_truncated") (aget info "cursor"))
                               (page (aget info "cursor") acc)
                               {:ok? true :keys acc}))))))]
      (-> (page nil [])
          (.catch (fn [e] {:ok? false :error :r2/list-failed :detail (str (.-message e))}))))
    (js/Promise.resolve {:ok? false :error :r2/no-credential})))
