<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  cloud.itonami.otent-weather — one GFS ingest: every frame of the latest
  forecast into R2, then the manifest, then the run before last pruned.

  Every six hours, because that is the GFS cycle: asking faster returns the
  same run. Its own job rather than a feed in the tick, because the tick
  writes rows to Iceberg and this writes one grid object per frame -- a
  different store with a different retention (the manifest's `previous`
  run, not a horizon), and a failure of one should not hold the other.

  The logic is in bin/weather.cljk; the Keychain lookup is `--keychain`,
  by exact service and account (gftd.cf / API_TOKEN).

  install:
    cp ops/cloud.itonami.otent-weather.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/cloud.itonami.otent-weather.plist
  watch:
    tail -40 /tmp/otent-weather.err
  stop:
    launchctl bootout gui/$(id -u)/cloud.itonami.otent-weather
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cloud.itonami.otent-weather</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/junkawasaki/github/com-junkawasaki/orgs/cloud-itonami/otent &amp;&amp; exec /opt/homebrew/bin/kbb --backend sci --classpath src:../../kotoba-lang/sgp4/src:../../kotoba-lang/text/src bin/weather.cljk ingest --keychain</string>
  </array>

  <key>StartInterval</key>
  <integer>21600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/otent-weather.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/otent-weather.err</string>

  <!-- ~35 frames at ~5 s each against ERDDAP, plus the writes. -->
  <key>ExitTimeOut</key>
  <integer>1200</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
